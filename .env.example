# Copy this file to `.env` (or set the same values in Render's Environment tab).
#
# All four are OPTIONAL when self-hosting — the app primarily uses each
# visitor's own Cartesia API key, pasted into the BYO-key dialog and stored
# in localStorage. The server-side keys below only matter if you want:
#   - the voice catalog to populate before a visitor pastes their key, OR
#   - cached audio files to persist across container restarts.

# Vercel Blob (https://vercel.com/dashboard/stores)
# Without this, generated audio is cached on the container's ephemeral disk.
# Render's free tier wipes the disk on every redeploy / sleep wake-up.
BLOB_READ_WRITE_TOKEN=

# Cartesia (https://play.cartesia.ai/keys)
# Used only by the /api/voices endpoint to populate the voice picker.
# Voice generation always uses the visitor's own key from the request body.
CARTESIA_API_KEY=

# ElevenLabs (unused — tab is "Coming Soon" in the UI). Leave blank.
ELEVENLABS_API_KEY=

# Gemini (https://aistudio.google.com/app/apikey)
# Only used by `scripts/content-pipeline.ts` to auto-generate blog posts.
# Not needed for the app itself.
GEMINI_API_KEY=
