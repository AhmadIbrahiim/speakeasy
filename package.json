{
  "name": "speakeasy",
  "homepage": "https://voicemail.ahmed-ibrahim.com",
  "version": "1.0.0",
  "description": "Speakeasy: self-hosted voicemail, hold, and IVR audio generator (bring your own Cartesia key)",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate-thumbnail": "ts-node scripts/generate-thumbnail.ts",
    "pipeline": "ts-node scripts/content-pipeline.ts",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "prod:pm2:start": "pm2 start npm --name speakeasy -- start -- --port 3030",
    "prod:pm2:stop": "pm2 stop speakeasy",
    "prod:pm2": "next build && pm2 delete speakeasy && npm run prod:pm2:start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cartesia/cartesia-js": "^3.0.0",
    "@google/generative-ai": "^0.24.0",
    "@next/third-parties": "^15.5.26",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^20.11.16",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "crunker": "^2.4.0",
    "dotenv": "^16.4.1",
    "elevenlabs": "^0.18.0",
    "gray-matter": "^4.0.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.460.0",
    "mime-types": "^3.0.1",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-html": "^16.0.1",
    "sass": "^1.77.4",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@types/lodash": "^4.17.4",
    "@types/node": "^20.11.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.138.0"
  }
}
