{
  "name": "voicemail-greeting",
  "version": "1.0.0",
  "description": "Voicemail greeting generator with content pipeline",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pm2:start": "pm2 start npm --name voicemail-greeting -- start  -- --port 3030",
    "pm2:stop": "pm2 stop voicemail-greeting",
    "prod": "next build && pm2 delete voicemail-greeting  &&  npm run pm2:start",
    "generate-thumbnail": "node scripts/generate-thumbnail.js",
    "pipeline": "ts-node scripts/content-pipeline.ts"
  },
