
server {
    listen 80;
    server_name 67.205.164.83;
    return 301 https://www.perfectgreet.site$request_uri;
}

server {
        server_name www.perfectgreet.site
        root /var/www/html;
        # Add index.php to the list if you are using PHP
        index index.html index.htm index.nginx-debian.html;
        server_name _;
        location / {
                proxy_pass http://127.0.0.1:3030;
        }

}
